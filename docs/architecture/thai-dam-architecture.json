  "cards": [
    {
      "dot": "cyan",
      "title": "1. Live Dashboard & DB-First Sync",
      "items": [
        "Checks MySQL/TiDB first (check_date_exists_in_db) before calling RID API",
        "Pooled connection (DB_POOL) serves 34 large reservoirs across 6 regions",
        "Renders 7 sections with custom CSS, Plotly trend lines & semantic footer"
      ]
    },
    {
      "dot": "amber",
      "title": "2. 4-Layer Missing Value Defense",
      "items": [
        "Layer 1 (Live API): 3-day backward lookback when today's RID report is delayed",
        "Layer 2 (DB Impute): Replaces NULL storage/inflow with yesterday's valid row",
        "Layer 3 (Offline ETL): Continuous daily reindex + Forward Fill (ffill)",
        "Layer 4 (ML Engine): Safe fallback defaults & zero-division guards"
      ]
    },
    {
      "dot": "emerald",
      "title": "3. Dual-Horizon Weka ML Forecasting",
      "items": [
        "Normalizes storage %, inflow %, outflow %, and seasonal month (1-12)",
        "7-Day Horizon: Logistic Regression (Log_7days.model) for short-term sensitivity",
        "30-Day Horizon: Random Forest (RF_30days.model) for non-linear monthly trends",
        "Classifies water risk into 3 tiers: LOW (<30%), NORMAL (30-80%), HIGH (>80%)"
      ]
    }
  ]
