# ==============================================================================
# ตัวอย่างการตั้งค่า Streamlit Secrets สำหรับ Deploy บน Streamlit Community Cloud
# ==============================================================================
# เมื่อนำขึ้น Streamlit Cloud:
# 1. ไปที่ https://share.streamlit.io/
# 2. กดที่เมนู (จุด 3 จุด) ของ App -> Settings -> Secrets
# 3. คัดลอกข้อความด้านล่างไปวาง แล้วเปลี่ยนค่า Host, Username, Password เป็นของท่าน
# ==============================================================================

# ------------------------------------------------------------------------------
# รูปแบบที่ 1: TiDB Cloud Serverless (แนะนำอย่างยิ่ง - ฟรี 5GB ตลอดชีพ)
# หมายเหตุ: TiDB Cloud ใช้พอร์ต 4000 และชื่อผู้ใช้มักมี Prefix นำหน้า เช่น xxxxxx.root
# ระบบของเราจะตรวจจับและเปิดใช้งาน SSL/TLS ให้โดยอัตโนมัติ
# ------------------------------------------------------------------------------
[connections.mysql]
dialect = "mysql"
host = "gateway01.us-east-1.prod.aws.tidbcloud.com"
port = 4000
database = "dam_forecast_db"
username = "your_tidb_username.root"
password = "your_tidb_password"

# ------------------------------------------------------------------------------
# API ปริมาณน้ำเขื่อนจากกรมชลประทาน
# ------------------------------------------------------------------------------
RID_API_URL = "https://app.rid.go.th/reservoir/api/dam/public/"

# ------------------------------------------------------------------------------
# (ตัวเลือกเสริม) หากต้องการระบุแบบ Flat Keys แทน:
# DB_HOST = "gateway01.us-east-1.prod.aws.tidbcloud.com"
# DB_PORT = 4000
# DB_USER = "your_tidb_username.root"
# DB_PASSWORD = "your_tidb_password"
# DB_NAME = "dam_forecast_db"
# RID_API_URL = "https://app.rid.go.th/reservoir/api/dam/public/"
# ------------------------------------------------------------------------------

